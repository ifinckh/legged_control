<?xml version="1.0"?>

<package format="2">

  <name>anymal_d_description</name>
  <version>1.0.9</version>
  <description>ANYmal Description Package</description>

  <license>BSD-3</license>

  <author email="lisler@anybotics.com">Linus Isler</author>
  <maintainer email="lisler@anybotics.com">Linus Isler</maintainer>
  <maintainer email="rdiethelm@anybotics.com">Remo Diethelm</maintainer>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>roslaunch</test_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>legged_common</exec_depend>
  <exec_depend>legged_controllers</exec_depend>
  <exec_depend>legged_gazebo</exec_depend>
  <exec_depend>legged_unitree_description</exec_depend>
  <exec_depend>rviz2</exec_depend>

    <export>
        <build_type>ament_cmake</build_type>
        <!-- Tells gazebo_ros to add this package's share/.. directory to
             GAZEBO_MODEL_PATH, so Gazebo can resolve
             model://legged_unitree_description/meshes/{robot_type}/*.dae -->
        <gazebo_ros gazebo_model_path="${prefix}/.."/>
    </export>

</package>
