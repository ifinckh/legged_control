                </gz-gui>
            </plugin>
            <plugin filename="CopyPaste" name="CopyPaste">
                <gz-gui>
                    <property key="resizable" type="bool">false</property>
                    <property key="x" type="double">300</property>
                    <property key="y" type="double">50</property>
                    <property key="width" type="double">100</property>
                    <property key="height" type="double">50</property>
                    <property key="state" type="string">floating</property>
                    <property key="showTitleBar" type="bool">false</property>
                    <property key="cardBackground" type="string">#777777</property>
                </gz-gui>
            </plugin>
            <plugin filename="ComponentInspector" name="Component inspector">
                <gz-gui>
                    <property type="bool" key="showTitleBar">false</property>
                    <property type="string" key="state">docked</property>
                </gz-gui>
            </plugin>
            <plugin filename="EntityTree" name="Entity tree">
                <gz-gui>
                    <property type="bool" key="showTitleBar">false</property>
                    <property type="string" key="state">docked</property>
                </gz-gui>
            </plugin>
        </gui>

        <spherical_coordinates>
            <surface_model>EARTH_WGS84</surface_model>
            <latitude_deg>46.50517716653482</latitude_deg>
            <longitude_deg>11.387928661058481</longitude_deg>
            <elevation>547.6000000000004</elevation>
        </spherical_coordinates>

        <!-- OGRE2 ignores both model and link <pose> for heightmap visuals;
             visual position is controlled by <heightmap><pos> (world frame).
             DART ignores <heightmap><pos> for collision; collision position
             is controlled by <collision><pose> (standard SDF pose chain). -->
        <model name="terrain_03">
            <static>true</static>
            <pose>0 0 0 0 0 0</pose>

            <link name="ground">
                <collision name="collision">
                    <pose>-0.48 -0.15 0 0 0 0</pose>
                    <geometry>
                        <heightmap>
                            <uri>../models/terrain_03/mesh/height_map.png</uri>
                            <size>64.64 50.83 23.2</size>
                            <!-- DART ignores <pos> for collision heightmaps; positioning
                                 is handled by <collision><pose> above instead -->
                            <pos>0 0 0</pos>
                        </heightmap>
                    </geometry>
                </collision>
                <visual name="ground_visual">
                    <geometry>
                        <heightmap>
                            <use_terrain_paging>false</use_terrain_paging>
                            <texture>
                                <diffuse>../models/terrain_03/mesh/aerial.png</diffuse>
                                <normal>../models/terrain_03/mesh/normal_map.png</normal>
                                <size>64.64</size>
                            </texture>
                            <uri>../models/terrain_03/mesh/height_map.png</uri>
                            <size>64.64 50.83 23.2</size>
                            <!-- OGRE2 ignores model/link <pose> for heightmaps; <pos> is world frame -->
                            <pos>-0.48 -0.15 0.0</pos>
                            <!-- sampling: mesh vertices per heightmap pixel (SDF 1.8+ default = 1).
                                 Tested with 16-bit heightmaps at sampling 1, 4, 8: no visual or
                                 physics difference observed — OGRE2 interpolates extra vertices but
                                 the result is indistinguishable at SRTM source resolution. Higher
                                 values only increase vertex buffer memory (cost scales as sampling²).
                                 sdformat PR #459 changed default from 2->1: "no good reason to
                                 subsample by default". Explicitly set to 1 to match intent. -->
                            <sampling>1</sampling>
                        </heightmap>
                    </geometry>
                </visual>
            </link>





        </model>

    

